# ==============================================================
# Invoixy Environment Configuration
# ==============================================================

# --- DATABASE CONFIGURATION ---
# Local SQLite development (default):
DATABASE_URL="file:./dev.db"

# Production on Vercel (using Turso / libSQL cloud SQLite):
# DATABASE_URL="libsql://your-database-name-username.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# --- AUTHENTICATION & SECURITY ---
# Secret key used for signing JWT cookies and sessions (generate a secure random 32-char string)
AUTH_SECRET="replace-with-a-secure-random-secret"

# --- GOOGLE OAUTH (Optional for Multi-Tenant / Google Sign-In) ---
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
# Add your Vercel URL to Authorized Redirect URIs:
# https://your-deployment-name.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
