// GST invoice generator — single-business SQLite schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// One row holds the seller / company profile for a shop.
model SellerSettings {
  id            Int      @id @default(autoincrement())
  companyName   String
  address       String
  pan           String
  gstin         String
  stateName     String
  stateCode     String
  phone         String
  bankName      String
  bankAccountNo String
  bankIfsc      String
  bankBranch    String
  declaration   String
  invoicePrefix String   @default("ECMUM")
  logoDataUrl   String   @default("")
  shopId        String?  @unique
  shop          Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Stores each issued invoice as an immutable snapshot for reprint/history.
model Invoice {
  id                 Int      @id @default(autoincrement())
  invoiceNumber      String   @unique
  financialYear      String
  sequenceNumber     Int
  invoiceDate        String
  modeOfPayment      String
  buyersOrderNo      String
  dispatchDocNo      String
  deliveryNoteDate   String
  dispatchedThrough  String
  destination        String
  deliveryAddress    String
  dueDate            String   @default("")
  buyerName          String
  buyerAddress       String
  buyerGstin         String
  buyerStateName     String
  buyerStateCode     String
  taxMode            String
  gstRatePercent     Float
  roundOffEnabled    Boolean
  totalQuantity      Float
  subtotal           Float
  cgstRate           Float
  sgstRate           Float
  igstRate           Float
  cgstAmount         Float
  sgstAmount         Float
  igstAmount         Float
  roundOff           Float
  grandTotal         Float
  amountInWords      String
  paymentStatus      String   @default("unpaid")
  paidAmount         Float    @default(0)
  paymentDate        String   @default("")
  paymentMethod      String   @default("")
  paymentNotes       String   @default("")
  shopId             String?
  shop               Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lines              InvoiceLine[]

  @@index([invoiceDate])
  @@index([buyerName])
  @@index([buyerGstin])
  @@index([paymentStatus])
  @@index([shopId])
}

model InvoiceLine {
  id              Int      @id @default(autoincrement())
  invoiceId       Int
  lineOrder       Int
  description     String
  hsnSac          String
  quantity        Float
  rate            Float
  unit            String
  discountPercent Float
  gstRatePercent  Float    @default(5)
  cgstAmount      Float    @default(0)
  sgstAmount      Float    @default(0)
  igstAmount      Float    @default(0)
  amount          Float
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceSequence {
  financialYear String   @id
  lastNumber    Int
  shopId        String?
  shop          Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  gstin     String
  stateName String
  stateCode String
  shopId    String?
  shop      Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([gstin])
  @@index([shopId])
}

model Product {
  id                    Int      @id @default(autoincrement())
  description           String
  hsnSac                String
  unit                  String
  defaultRate           Float
  defaultGstRatePercent Float    @default(5)
  shopId                String?
  shop                  Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([description])
  @@index([hsnSac])
  @@index([shopId])
}

/// Singleton (id = 1) that persists the in-progress new-invoice draft to the DB.
/// Survives browser clears, incognito, and switching devices on the same machine.
model InvoiceDraftRecord {
  id        Int      @id @default(1)
  draftJson String   @default("{}")
  shopId    String?  @unique
  shop      Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

/// Stores application-wide security settings, including auth preference and hashed passwords
model SecuritySettings {
  id          Int      @id @default(1)
  authEnabled Boolean  @default(true)
  authType    String   @default("PIN") // "PIN" or "PASSWORD"
  authHash        String?  // Securely hashed password/PIN. Null means it hasn't been set up yet.
  recoveryHash    String?  // Securely hashed one-time backup recovery code.
  autoLockMinutes Int      @default(15) // Minutes of inactivity before session expires
  updatedAt       DateTime @updatedAt
}


// ─────────────────────────────────────────────────────────────
// Multi-Tenant Architecture (Users, Shops & Memberships)
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  googleId      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  memberships   ShopMember[]

  @@index([email])
}

model Shop {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  members       ShopMember[]
  sellerProfile SellerSettings?
  invoices      Invoice[]
  customers     Customer[]
  products      Product[]
  sequences     InvoiceSequence[]
  drafts        InvoiceDraftRecord[]

  @@index([slug])
}

model ShopMember {
  id        String   @id @default(cuid())
  userId    String
  shopId    String
  role      String   @default("OWNER") // "OWNER" | "MEMBER"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([userId])
  @@index([shopId])
}

